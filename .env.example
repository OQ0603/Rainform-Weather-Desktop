# Optional Alibaba Cloud Marketplace credentials for the official Moji Weather
# professional latitude/longitude API. Set real values only in the process or
# Windows user environment; never save them in this file or source control.
MOJI_WEATHER_APPCODE=
MOJI_WEATHER_CONDITION_TOKEN=
MOJI_WEATHER_FORECAST_TOKEN=

# Backward-compatible aliases. PASSWORD is treated as APPCode; TOKEN is used as
# a shared endpoint token when the endpoint-specific values above are absent.
MOJI_WEATHER_TOKEN=
MOJI_WEATHER_PASSWORD=
